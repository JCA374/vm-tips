# Example environment variables - copy to .env and fill in values

# Flask
SECRET_KEY=your-secret-key-here

# Database (optional, defaults to database/vm_tips.db)
# DATABASE_PATH=/path/to/database.db

# Email (Brevo)
# MAIL_API_KEY: get from brevo.com > account > SMTP & API > API Keys (starts with xkeysib-)
# MAIL_DEFAULT_SENDER: must be a verified sender in Brevo
# NOTE: SMTP (port 587) is blocked on DigitalOcean — the app uses Brevo's HTTP API instead
MAIL_API_KEY=your-brevo-api-key
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Football Data API
# Sign up at https://www.football-data.org (free tier available)
FOOTBALL_API_KEY=your-football-data-api-key

# Admin
ADMIN_EMAIL=admin@example.com

# Application URL
APP_URL=https://storahultsvm.se
