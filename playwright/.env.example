# Copy this to .env and fill in values before running tests

# Target environment (default: local)
BASE_URL=http://localhost:5000

# Test user credentials (must have a password set via /auth/set-password)
TEST_EMAIL=your-email@example.com
TEST_PASSWORD=your-password

# Admin user credentials (must be admin in the DB)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
